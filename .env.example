# Copy to .env.local (development) or set these on the AWS host. Never commit real values.

# --- SMTP (required) ---
SMTP_HOST=smtp.example.com
# 587 = STARTTLS (SMTP_SECURE=false), 465 = TLS from the first byte (SMTP_SECURE=true)
SMTP_PORT=587
SMTP_SECURE=false
# Sending is refused unless the connection is encrypted (STARTTLS on 587). Leave unset in
# production; only a local test mail server (scripts/mail-sink.mjs) needs SMTP_REQUIRE_TLS=false.
# SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=

# Sender shown on the email. Most providers only accept an address on a verified domain.
MAIL_FROM="Spectrum Financial Website <no-reply@spectrumbusinessfinance.com>"
# Where applications and quote requests are delivered. Several addresses: separate with commas.
MAIL_TO=owner@example.com

# --- Optional ---
# Time zone used for the "Dated" and "Sign Date/Timestamp" values on the PDF.
APP_TIMEZONE=America/Los_Angeles
# Number of proxies in front of the app that append to X-Forwarded-For
# (1 = ALB or nginx, 2 = CloudFront + ALB). Used for the signer IP on the PDF and for rate limiting.
# Must match the real setup: too low and visitors share the proxy's IP (and its rate limit);
# with no proxy at all the IP is "not available" and only the all-visitors limit applies.
TRUSTED_PROXY_HOPS=1
# The forms only accept posts whose Origin matches the Host the app receives. Behind CloudFront
# the app usually receives the ALB's own host name, so EITHER forward the Host header in the
# CloudFront origin request policy, OR list the public origins here (comma separated), e.g.
# https://spectrumbusinessloans.com,https://www.spectrumbusinessloans.com
# Refused posts are logged as "*.forbidden_origin" with the origin and host seen.
ALLOWED_ORIGINS=
# Total size allowed for the bank statements attached on step 4, in MB.
# BUILD-TIME value: it is baked into the page and the API by `next build`; changing it on a
# running server does nothing, rebuild instead.
# Keep it under your SMTP provider's message limit (base64 adds ~33%).
# On Amplify / Lambda the request itself is capped at ~6 MB, so use 4 there.
NEXT_PUBLIC_UPLOAD_MAX_TOTAL_MB=15
